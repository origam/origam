# Copy to .env.postgresql and point at the database used by your local test application.
DatabaseType=postgresql
OrigamSettings__DataConnectionString="Host=localhost;Port=5432;Database=origam_test;Username=postgres;Password=REPLACE_ME;SSL Mode=Disable"
ORIGAM_E2E_URL=https://localhost:44357
ORIGAM_E2E_USERNAME=username
ORIGAM_E2E_PASSWORD=password
ORIGAM_E2E_SERVER_CLIENT_SECRET=serverSecret
# Keep the Playwright UI visible while the test browser runs without a window.
ORIGAM_E2E_HEADLESS=true
