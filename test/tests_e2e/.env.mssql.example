# Copy to .env.mssql and point at the database used by your local test application.
DatabaseType=mssql
OrigamSettings__DataConnectionString="Encrypt=False;Data Source=.;Initial Catalog=origam_test;Integrated Security=True;User ID=;Password=;Pooling=True"
# For SQL authentication, replace Integrated Security=True with User ID=...;Password=...
# Windows authentication requires ODBC Driver 18 for SQL Server and msnodesqlv8.
ORIGAM_E2E_URL=https://localhost:44357
ORIGAM_E2E_USERNAME=username
ORIGAM_E2E_PASSWORD=password
ORIGAM_E2E_SERVER_CLIENT_SECRET=serverSecret
# Keep the Playwright UI visible while the test browser runs without a window.
ORIGAM_E2E_HEADLESS=true
