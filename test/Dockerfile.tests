ARG SERVER_IMAGE=origam-server-linux
ARG SERVER_RUNTIME_IMAGE=${SERVER_IMAGE}
FROM ${SERVER_IMAGE} AS application
FROM ${SERVER_RUNTIME_IMAGE} AS test-dependencies

# Ensure we run privileged steps as root
USER root
SHELL ["/bin/bash", "-c"]

# INSTALL dotnet SDK (because we will run dotnet test later on)
RUN apt-get -qq update \
 && apt-get -qq install -y wget gpg apt-transport-https sudo \
 && wget https://packages.microsoft.com/config/debian/12/packages-microsoft-prod.deb -O /tmp/packages-microsoft-prod.deb \
 && dpkg -i /tmp/packages-microsoft-prod.deb \
 && rm /tmp/packages-microsoft-prod.deb \
 && apt-get -qq update \
 && apt-get -qq install -y dotnet-sdk-8.0 

# Install Chrome (modern keyring flow; no apt-key)
RUN set -eux; \
    apt-get -qq update; \
    DEBIAN_FRONTEND=noninteractive apt-get -qq install -y --no-install-recommends \
      ca-certificates curl gnupg \
      fonts-ipafont-gothic fonts-wqy-zenhei fonts-thai-tlwg fonts-kacst fonts-freefont-ttf \
      libxss1; \
    install -d -m 0755 /etc/apt/keyrings; \
    curl -fsSL https://dl.google.com/linux/linux_signing_key.pub \
      | gpg --dearmor -o /etc/apt/keyrings/google-linux-signing-keyring.gpg; \
    echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/google-linux-signing-keyring.gpg] https://dl.google.com/linux/chrome/deb/ stable main" \
      > /etc/apt/sources.list.d/google-chrome.list; \
    apt-get -qq update; \
    DEBIAN_FRONTEND=noninteractive apt-get -qq install -y --no-install-recommends google-chrome-stable; \
    rm -rf /var/lib/apt/lists/*

# Install gawk
RUN apt-get -qq update && apt-get -qq install -y --no-install-recommends gawk && rm -rf /var/lib/apt/lists/*

FROM test-dependencies AS playwright-dependencies

USER origam
WORKDIR /home/origam/server_bin/tests_e2e
COPY --chown=origam:origam tests_e2e/package.json tests_e2e/yarn.lock ./
RUN yarn install --frozen-lockfile \
 && yarn playwright install ffmpeg

FROM test-dependencies AS legacy-dependencies

USER origam
WORKDIR /home/origam/server_bin/tests_e2e_legacy
COPY --chown=origam:origam tests_e2e_legacy/package.json tests_e2e_legacy/yarn.lock ./
RUN yarn install --frozen-lockfile --ignore-scripts

FROM test-dependencies AS tests

COPY --from=application --chown=origam:origam /home/origam/ /home/origam/

# Copy test files
USER origam
WORKDIR /home/origam
RUN mkdir -p server_bin/data/origam tests_workflow output

COPY --chown=origam:origam entrypoint.sh \
    /home/origam/server_bin/

COPY --chown=origam:origam tests_workflow \
    _OrigamSettings.wf.mssql.template \
    _OrigamSettings.wf.pgsql.template \
    log4net.config \
    /home/origam/tests_workflow/

COPY --chown=origam:origam tests_e2e /home/origam/server_bin/tests_e2e/
COPY --chown=origam:origam tests_e2e_legacy /home/origam/server_bin/tests_e2e_legacy/
COPY --from=playwright-dependencies --chown=origam:origam /home/origam/server_bin/tests_e2e/node_modules /home/origam/server_bin/tests_e2e/node_modules/
COPY --from=playwright-dependencies --chown=origam:origam /home/origam/.cache/ms-playwright /home/origam/.cache/ms-playwright/
COPY --from=legacy-dependencies --chown=origam:origam /home/origam/server_bin/tests_e2e_legacy/node_modules /home/origam/server_bin/tests_e2e_legacy/node_modules/
COPY --chown=origam:origam model /home/origam/projectData/model/

WORKDIR /home/origam/server_bin
RUN chmod +x entrypoint.sh

ENTRYPOINT ["/bin/bash", "-c", "./entrypoint.sh"]
