<Project>
  <PropertyGroup>
    <Configurations>Debug;Release;Debug Architect Server;Release Architect Server;Debug Server;Release Server</Configurations>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.StartsWith('Debug'))">
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
    <Optimize>false</Optimize>
    <OutputPath>bin/Debug/</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.StartsWith('Release'))">
    <Optimize>true</Optimize>
    <OutputPath>bin/Release/</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug Server' or '$(Configuration)' == 'Release Server'">
    <DefineConstants>$(DefineConstants);ORIGAM_SERVER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Preserve the extended analyzer coverage independently of target frameworks. -->
    <EnableExtendedAnalysis
      Condition="'$(MSBuildProjectName)' == 'origam-utils' or '$(MSBuildProjectName)' == 'Origam.AI.Agent' or '$(MSBuildProjectName)' == 'Origam.AI.Agent.Tests' or '$(MSBuildProjectName)' == 'Origam.Architect.Server' or '$(MSBuildProjectName)' == 'Origam.Composer' or '$(MSBuildProjectName)' == 'Origam.Server' or '$(MSBuildProjectName)' == 'Origam.Server.Common' or '$(MSBuildProjectName)' == 'Origam.ServerTests' or '$(MSBuildProjectName)' == 'Origam.WorkflowTests' or '$(MSBuildProjectName)' == 'OrigamScheduler'"
      >true</EnableExtendedAnalysis>
    <!-- Keep dependency auditing scoped to direct package references. -->
    <NuGetAuditMode Condition="'$(NuGetAuditMode)' == ''">direct</NuGetAuditMode>
    <!-- 
      Enabiling origam-utils causes the tests on github to fail with 
      System.PlatformNotSupportedException: System.Data.SqlClient is not supported on this platform.
      Replacing the System.Data.SqlClient with its newer counter part does not fix the problem.
-->
    <DisableStrictBuild Condition="'$(MSBuildProjectName)' == 'origam-utils'"
      >true</DisableStrictBuild>
    <!--      
    Enabling Origam.Documentation causes this error during build:
    43>Origam.Documentation.csproj: Error MSB4057 : The target "CSharpierFormatInner" does not exist in the project.
-->
    <DisableStrictBuild Condition="'$(MSBuildProjectName)' == 'Origam.Documentation'"
      >true</DisableStrictBuild>
  </PropertyGroup>
  <Choose>
    <When Condition="'$(DisableStrictBuild)' != 'true'">
      <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <MeziantouAnalysisMode>None</MeziantouAnalysisMode>
        <AnalysisLevel>8.0</AnalysisLevel>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <CSharpier_FrameworkVersion>net10.0</CSharpier_FrameworkVersion>
        <CSharpier_Check>false</CSharpier_Check>
      </PropertyGroup>

      <ItemGroup>
        <PackageReference
          Include="Roslynator.Analyzers"
          Version="5.0.1"
          PrivateAssets="all"
          IncludeAssets="build;analyzers;buildtransitive"
        />
        <PackageReference
          Include="Roslynator.Formatting.Analyzers"
          Version="5.0.1"
          PrivateAssets="all"
          IncludeAssets="build;analyzers;buildtransitive"
        />
        <PackageReference
          Include="CSharpier.MsBuild"
          Version="1.3.0"
          PrivateAssets="all"
          IncludeAssets="build;analyzers;buildtransitive"
        />
        <PackageReference
          Include="Meziantou.Analyzer"
          Condition="'$(EnableExtendedAnalysis)' == 'true'"
          Version="3.0.315"
          PrivateAssets="all"
          IncludeAssets="build;analyzers;buildtransitive"
        />
        <EditorConfigFiles
          Include="$(MSBuildThisFileDirectory)origam.globalconfig"
          Condition="'$(EnableExtendedAnalysis)' == 'true'"
        />
        <ProjectReference
          Include="$(MSBuildThisFileDirectory)Origam.Analyzers\Origam.Analyzers.csproj"
          OutputItemType="Analyzer"
          ReferenceOutputAssembly="false"
          Condition="'$(MSBuildProjectName)' != 'Origam.Analyzers'"
        />
      </ItemGroup>

      <PropertyGroup Condition="'$(Configuration)' == 'Release Server' or '$(Configuration)' == 'Release Architect Server'">
        <CSharpier_Check>true</CSharpier_Check>
      </PropertyGroup>
    </When>
  </Choose>
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS1591;CS1573;RCS1075;RCS1102;CS1572;CS0419;CS1734;RCS1263;RCS1138;CS1587;CS1574;CS1570;RCS1139;CS1584;CS1658;</NoWarn>
  </PropertyGroup>
</Project>
