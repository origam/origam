<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>false</EnableDefaultItems>
    <LangVersion>10</LangVersion>
    <AssemblyName>Origam.Common_net2Tests</AssemblyName>
    <RootNamespace>Origam.Common_net2Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ExtensionsTests.cs" />
    <Compile Include="DebugTimerTests.cs" />
    <Compile Include="HttpToolsTests.cs" />
    <Compile Include="IOToolsTests.cs" />
    <Compile Include="OrigamSettingsReaderTests.cs" />
    <Compile Include="ConfigurationManagerTests.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Origam.Common\Origam.Common.csproj"></ProjectReference>
    <ProjectReference
      Include="..\Origam.ReflectorCache\Origam.ReflectorCache.csproj"
    ></ProjectReference>
    <ProjectReference Include="..\Origam.Schema\Origam.Schema.csproj"></ProjectReference>
    <ProjectReference Include="..\Origam.Security\Origam.Security.csproj"></ProjectReference>
    <ProjectReference Include="..\Origam.TestCommon\Origam.TestCommon.csproj"></ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Content Include="TestFiles\OrigamSettings.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="TestFiles\OrigamSettingsWithArrayOfOrigamSettingsMissing.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="log4net">
      <Version>3.5.0</Version>
    </PackageReference>
    <PackageReference Include="morelinq">
      <Version>4.1.0</Version>
    </PackageReference>
    <PackageReference Include="NUnit">
      <Version>3.14.0</Version>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter">
      <Version>6.3.1</Version>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
  </ItemGroup>
</Project>
