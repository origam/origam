<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);SYSLIB0023;SYSLIB0041;SYSLIB0045</NoWarn>
    <RunAnalyzers>false</RunAnalyzers>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <PropertyGroup>
    <Version>0.0.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk">
      <Version>17.9.0</Version>
    </PackageReference>
    <PackageReference Include="NUnit">
      <Version>3.14.0</Version>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter">
      <Version>6.3.1</Version>
    </PackageReference>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Moq" Version="4.21.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Origam.Server\Origam.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content
      Include="..\Origam.Server\TemplateFiles\_appsettings.json"
      Link="CertificateLogging\server-appsettings.json"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="..\Origam.Server\TemplateFiles\_log4net.config"
      Link="CertificateLogging\server-log4net.config"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="..\..\docker\server\_appsettings.template"
      Link="CertificateLogging\docker-appsettings.json"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="..\..\docker\server\log4net.server.config"
      Link="CertificateLogging\docker-log4net.config"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
